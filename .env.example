# Canonical public origin (no trailing slash). On Vercel/Netlify this falls back to the
# platform URL automatically; set it explicitly once a custom domain is attached.
NEXT_PUBLIC_SITE_URL=

# auto | on | off: "auto" indexes production deployments only (previews get noindex).
SITE_INDEXING=auto

# Optional: shared rate limiting across serverless instances (Upstash Redis free tier).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: send appointment requests to a real system (signed with HMAC-SHA256).
# Without these, booking runs in clearly labelled demonstration mode.
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=

# Optional: Chrome origin-trial token for WebMCP (lets browser AI agents call the
# site's tools). Register your domain at https://developer.chrome.com/origintrials
NEXT_PUBLIC_WEBMCP_TOKEN=

# Self-hosting with more than one instance only: stable Server Actions encryption key
# (generate with: openssl rand -base64 32).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
