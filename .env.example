# Public origin, no trailing slash; falls back to the Vercel/Netlify URL until a custom domain is set.
NEXT_PUBLIC_SITE_URL=

# auto | on | off: "auto" indexes production only (previews get noindex).
SITE_INDEXING=auto

# Optional: forward bookings to a real system (HMAC-SHA256 signed); unset = demo mode.
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=

# Optional: Chrome origin-trial token for WebMCP, from https://developer.chrome.com/origintrials
NEXT_PUBLIC_WEBMCP_TOKEN=

# Multi-instance self-hosting only: Server Actions key (openssl rand -base64 32).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
